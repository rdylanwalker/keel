# ==============================================================================
# Keel Multi-Cloud Free-Tier Live E2E Configuration (.env.cloud-e2e)
# ==============================================================================
# This file is automatically loaded by:
#   - `just test-e2e-cloud`
#   - `pnpm --dir e2e test:live:cloud`
#
# DUAL-GUARD CONTRACT:
# A cloud provider's live E2E tests will ONLY execute when BOTH:
#   1. Its toggle variable is set to `1` (or `KEEL_E2E_CLOUD_ALL=1`), AND
#   2. All required credentials for that provider are populated below.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Provider Execution Toggles (Set to 1 to enable, 0 to skip)
# ------------------------------------------------------------------------------
KEEL_E2E_CLOUD_ALL=0
KEEL_E2E_CLOUD_AWS=0
KEEL_E2E_CLOUD_AZURE=0
KEEL_E2E_CLOUD_GCP=0

# ------------------------------------------------------------------------------
# 2. Amazon Web Services (AWS Free Tier — EC2 t3.micro / t2.micro + S3)
# ------------------------------------------------------------------------------
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Optional temporary STS session token (leave blank for standard IAM access keys)
AWS_SESSION_TOKEN=
AWS_REGION=us-east-1
KEEL_E2E_AWS_INSTANCE_TYPE=t3.micro

# ------------------------------------------------------------------------------
# 3. Microsoft Azure (Azure Free Tier — Linux VM Standard_B1s)
# ------------------------------------------------------------------------------
ARM_CLIENT_ID=
ARM_CLIENT_SECRET=
ARM_TENANT_ID=
ARM_SUBSCRIPTION_ID=
AZURE_LOCATION=eastus
KEEL_E2E_AZURE_VM_SIZE=Standard_B1s

# ------------------------------------------------------------------------------
# 4. Google Cloud Platform (GCP Free Tier — Compute Engine e2-micro in us-central1-a)
# ------------------------------------------------------------------------------
# Provide EITHER the absolute path to your Service Account JSON key file:
GOOGLE_APPLICATION_CREDENTIALS=
# OR the raw single-line JSON key string:
GOOGLE_CREDENTIALS=
GCP_PROJECT=
GCP_REGION=us-central1
GCP_ZONE=us-central1-a
KEEL_E2E_GCP_MACHINE_TYPE=e2-micro
