  "values": [
    {
      "name": "undeclared keys under an open schema",
      "schema": {
        "type": "object"
      },
      "values": {
        "auth": {
          "password": "hunter2",
          "existingSecret": "db-auth",
          "username": "admin"
        },
        "replicas": 2
      },
      "expected": ["auth.password"]
    },
    {
      "name": "declared plain string property",
      "schema": {
        "type": "object",
        "properties": {
          "apiToken": {
            "type": "string"
          }
        }
      },
      "values": {
        "apiToken": "abc"
      },
      "expected": ["apiToken"]
    },
    {
      "name": "schema-declared secrets are not heuristic matches",
      "schema": {
        "type": "object",
        "properties": {
          "adminPassword": {
            "type": "string",
            "writeOnly": true
          }
        }
      },
      "values": {
        "adminPassword": "hunter2"
      },
      "expected": []
    },
    {
      "name": "writeOnly false opts a field out (catalog author control)",
      "schema": {
        "type": "object",
        "properties": {
          "tlsSecret": {
            "type": "string",
            "writeOnly": false
          }
        }
      },
      "values": {
        "tlsSecret": "my-tls"
      },
      "expected": []
    },
    {
      "name": "enum and const are no opt-out (only writeOnly: false is)",
      "schema": {
        "type": "object",
        "properties": {
          "tokenMode": {
            "type": "string"
          },
          "secretBackendKind": {
            "type": "string",
            "enum": ["vault", "aws"]
          },
          "token": {
            "const": "fixed"
          }
        }
      },
      "values": {
        "secretBackendKind": "vault",
        "token": "fixed"
      },
      "expected": ["token"]
    },
    {
      "name": "empty strings, booleans and null are not matched; numbers are",
      "schema": {
        "type": "object"
      },
      "values": {
        "password": "",
        "token": 42,
        "secret": true,
        "credentials": null,
        "automountServiceAccountToken": false,
        "pin": {
          "apiKey": 0
        }
      },
      "expected": ["pin.apiKey", "token"]
    },
    {
      "name": "list of strings under a secret-like key is matched as a whole",
      "schema": {
        "type": "object"
      },
      "values": {
        "apiTokens": ["a", "b"],
        "secretNames": ["x"]
      },
      "expected": ["apiTokens"]
    },
    {
      "name": "strings inside list items use the list path",
      "schema": {
        "type": "object"
      },
      "values": {
        "users": [
          {
            "name": "a",
            "password": "p"
          }
        ]
      },
      "expected": ["users[].password"]
    },
    {
      "name": "qualified annotation keys are skipped",
      "schema": {
        "type": "object"
      },
      "values": {
        "ingress": {
          "annotations": {
            "nginx.ingress.kubernetes.io/auth-secret": "basic-auth"
          }
        }
      },
      "expected": []
    },
    {
      "name": "a declared secret object hides its children",
      "schema": {
        "type": "object",
        "properties": {
          "smtp": {
            "type": "object",
            "writeOnly": true
          }
        }
      },
      "values": {
        "smtp": {
          "password": "p"
        }
      },
      "expected": []
    },
    {
      "name": "anyOf with an empty-string const branch keeps a real password secret",
      "schema": {
        "type": "object",
        "properties": {
          "adminPassword": {
            "anyOf": [
              {
                "const": ""
              },
              {
                "type": "string",
                "minLength": 8
              }
            ]
          }
        }
      },
      "values": {
        "adminPassword": "hunter2hunter2"
      },
      "expected": ["adminPassword"]
    },
    {
      "name": "numeric passwords and lists of numbers are matched",
      "schema": {
        "type": "object"
      },
      "values": {
        "redis": {
          "password": 123456
        },
        "pins": {
          "apiTokens": [1234, 5678]
        },
        "tokenTTL": 3600
      },
      "expected": ["pins.apiTokens", "redis.password"]
    },
    {
      "name": "dotted keys of flat property maps are judged by their last segment",
      "schema": {
        "type": "object"
      },
      "values": {
        "config": {
          "ssl.keystore.password": "ks",
          "ssl.keystore.location": "/ks.jks",
          "sasl_password": "s"
        }
      },
      "expected": ["config.sasl_password", "config.ssl.keystore.password"]
    },
    {
      "name": "keys of annotation and label maps are never matched",
      "schema": {
        "type": "object"
      },
      "values": {
        "podAnnotations": {
          "vault-token": "x"
        },
        "ingress": {
          "annotations": {
            "auth-secret": "basic-auth"
          }
        },
        "commonLabels": {
          "secret": "yes"
        }
      },
      "expected": []
    },
    {
      "name": "env-style short password keys",
      "schema": {
        "type": "object"
      },
      "values": {
        "extraEnv": {
          "DB_PASS": "hunter2",
          "BYPASS": "x"
        }
      },
      "expected": ["extraEnv.DB_PASS"]
    }
  ]
}
