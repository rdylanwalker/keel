{
  "name": "keel-e2e",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "playwright test",
    "test:live": "KEEL_E2E_LIVE=1 playwright test tests/07-kind-live-e2e.spec.ts --project=chromium",
    "demo:video": "KEEL_E2E_LIVE=1 KEEL_E2E_RECORD_DEMO=1 playwright test tests/07-kind-live-e2e.spec.ts --project=chromium",
    "screenshots": "node ./scripts/capture-screenshots.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.1",
    "@types/node": "^26.6.6",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.10.1",
    "typescript": "^6.0.0",
    "typescript-eslint": "^8.72.2"
  }
}
